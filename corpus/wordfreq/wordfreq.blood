// Word Frequency Counter in Blood
//
// Reads a text file, counts word frequencies, and reports results.
// Optionally writes results to an output file.
//
// Features exercised:
//   - Module system (mod stdlib_hashmap)
//   - HashMap (HashMapU64U32) for word hash -> index mapping
//   - Option<T> (Option.Some / Option.None) from HashMap lookups
//   - File output (file_write_string)
//   - String building and comparison (str_eq)
//   - Hashing (FNV-1a via stdlib hash_str)
//   - Vec<String> for storing unique words
//
// Usage: wordfreq <file> [-o output.txt]

mod stdlib_hashmap;

// --- Word extraction ---

fn is_alpha(b: u8) -> bool {
    (b >= 65 && b <= 90) || (b >= 97 && b <= 122)
}

fn to_lower(b: u8) -> u8 {
    if b >= 65 && b <= 90 {
        b + 32
    } else {
        b
    }
}

// Extract words from text, lowercased. Returns Vec<String>.
fn extract_words(text: &str) -> Vec<String> {
    let bytes = text.as_bytes();
    let len: usize = bytes.len();
    let mut words: Vec<String> = Vec.new();
    let mut i: usize = 0;

    while i < len {
        // Skip non-alpha
        while i < len && !is_alpha(bytes[i]) {
            i = i + 1;
        }
        if i >= len {
            break;
        }

        // Collect alpha chars as a word
        let mut word: String = String.new();
        while i < len && is_alpha(bytes[i]) {
            word.push(to_lower(bytes[i]) as char);
            i = i + 1;
        }
        words.push(word);
    }

    words
}

// --- Frequency counting ---

// Hash a String's contents for use as a HashMap key.
fn hash_word(w: &String) -> u64 {
    stdlib_hashmap.hash_string(w)
}

struct WordFreq {
    words: Vec<String>,
    counts: Vec<i32>,
    index: stdlib_hashmap.HashMapU64U32,
    total_words: i32,
}

fn wordfreq_new() -> WordFreq {
    WordFreq {
        words: Vec.new(),
        counts: Vec.new(),
        index: stdlib_hashmap.HashMapU64U32.new(),
        total_words: 0,
    }
}

// Find word index by linear scan (for hash collision resolution).
fn find_word(wf: &WordFreq, word: &String, start_idx: u32) -> i32 {
    // Check if the word at start_idx matches
    if str_eq(wf.words[start_idx as usize].as_str(), word.as_str()) {
        return start_idx as i32;
    }
    // Hash collision — shouldn't happen often with FNV-1a on short strings
    0 - 1
}

fn add_word(wf: &mut WordFreq, word: String) {
    wf.total_words = wf.total_words + 1;
    let h: u64 = hash_word(&word);

    match wf.index.get(h) {
        Option.Some(idx) => {
            // Hash exists — check if it's the same word
            if str_eq(wf.words[idx as usize].as_str(), word.as_str()) {
                // Same word, increment count
                wf.counts[idx as usize] = wf.counts[idx as usize] + 1;
            } else {
                // Hash collision — add as new word (linear probe not needed
                // for this demo, collisions are rare with FNV-1a)
                let new_idx: u32 = wf.words.len() as u32;
                wf.words.push(word);
                wf.counts.push(1);
                // Store with a slightly different key to avoid overwrite
                wf.index.insert(h + 1, new_idx);
            }
        }
        Option.None => {
            // New word
            let idx: u32 = wf.words.len() as u32;
            wf.words.push(word);
            wf.counts.push(1);
            wf.index.insert(h, idx);
        }
    }
}

// --- Sorting by frequency (descending) ---

fn sort_by_freq(words: &Vec<String>, counts: &mut Vec<i32>, order: &mut Vec<usize>) {
    // Initialize order as 0..n
    let n: usize = counts.len();
    let mut i: usize = 0;
    while i < n {
        order.push(i);
        i = i + 1;
    }

    // Insertion sort on order by counts[order[i]] descending
    let mut i: usize = 1;
    while i < n {
        let key_idx: usize = order[i];
        let key_count: i32 = counts[key_idx];
        let mut j: usize = i;
        while j > 0 && counts[order[j - 1]] < key_count {
            order[j] = order[j - 1];
            j = j - 1;
        }
        order[j] = key_idx;
        i = i + 1;
    }
}

// --- Output formatting ---

fn print_results(wf: &WordFreq, order: &Vec<usize>, limit: i32) {
    println_str("=== Word Frequency Analysis ===");
    println_str("");

    print_str("Total words:  ");
    println_int(wf.total_words);
    print_str("Unique words: ");
    println_int(wf.words.len() as i32);
    println_str("");

    println_str("--- Top words ---");
    let max: i32 = if limit < wf.words.len() as i32 { limit } else { wf.words.len() as i32 };
    let mut i: i32 = 0;
    while i < max {
        let idx: usize = order[i as usize];
        print_str("  ");
        print_int(wf.counts[idx]);
        print_str("  ");
        println(wf.words[idx].as_str());
        i = i + 1;
    }
}

fn build_output(wf: &WordFreq, order: &Vec<usize>) -> String {
    let mut out: String = String.new();
    out.push_str("word\tcount\n");

    let mut i: usize = 0;
    while i < order.len() {
        let idx: usize = order[i];
        out.push_str(wf.words[idx].as_str());
        out.push(9 as char);
        // Convert count to string manually
        let c: i32 = wf.counts[idx];
        let mut digits: Vec<i32> = Vec.new();
        let mut val: i32 = c;
        if val == 0 {
            digits.push(0);
        } else {
            while val > 0 {
                digits.push(val % 10);
                val = val / 10;
            }
        }
        // Reverse digits
        let mut d: usize = digits.len();
        while d > 0 {
            d = d - 1;
            out.push((48 + digits[d]) as u8 as char);
        }
        out.push(10 as char);
        i = i + 1;
    }

    out
}

// --- Entry point ---

fn main() -> i32 {
    let argc: i32 = args_count();
    if argc < 2 {
        println_str("Usage: wordfreq <file> [-o output.txt]");
        return 1;
    }

    let filename: &str = args_get(1);
    if !file_exists(filename) {
        print_str("Error: file not found: ");
        println_str(filename);
        return 1;
    }

    // Check for -o flag
    let mut output_file: String = String.new();
    let mut has_output: bool = false;
    if argc >= 4 {
        if str_eq(args_get(2), "-o") {
            output_file.push_str(args_get(3));
            has_output = true;
        }
    }

    // Read and process
    let content: &str = file_read_to_string(filename);
    let all_words: Vec<String> = extract_words(content);

    // Build frequency table
    let mut wf: WordFreq = wordfreq_new();
    let mut i: usize = 0;
    while i < all_words.len() {
        // Build a copy of the word (we need to move it)
        let mut copy: String = String.new();
        copy.push_str(all_words[i].as_str());
        add_word(&mut wf, copy);
        i = i + 1;
    }

    // Sort by frequency
    let mut order: Vec<usize> = Vec.new();
    sort_by_freq(&wf.words, &mut wf.counts, &mut order);

    // Print top 20
    print_results(&wf, &order, 20);

    // Write to file if requested
    if has_output {
        let out: String = build_output(&wf, &order);
        file_write_string(output_file.as_str(), out.as_str());
        println_str("");
        print_str("Results written to: ");
        println(output_file.as_str());
    }

    0
}
