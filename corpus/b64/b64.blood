// Base64 Encoder/Decoder in Blood
//
// A complete base64 codec demonstrating Blood's trait system,
// bitwise operations, struct methods, and byte-level processing.
//
// Features exercised:
//   - Traits (Codec) with implementations for multiple types
//   - Impl blocks with struct methods
//   - Bitwise operations (>>, <<, &, |) on i32
//   - for loops with ranges
//   - String building
//   - File I/O (encode/decode files)
//   - CLI argument parsing
//   - Byte-level string processing
//
// Usage:
//   b64 encode <text>
//   b64 decode <base64text>
//   b64 encode -f <file>
//   b64 decode -f <file>

// --- Codec trait ---

trait Codec {
    fn encode(self, input: &str) -> String;
    fn decode(self, input: &str) -> String;
}

// --- Base64 codec ---

struct Base64 {}

// Base64 helper functions (work on i32 to use bitwise ops)

fn b64_encode_sextet(val: i32) -> u8 {
    if val < 26 {
        (65 + val) as u8
    } else if val < 52 {
        (97 + val - 26) as u8
    } else if val < 62 {
        (48 + val - 52) as u8
    } else if val == 62 {
        43
    } else {
        47
    }
}

fn b64_decode_char(b: i32) -> i32 {
    if b >= 65 && b <= 90 {
        b - 65
    } else if b >= 97 && b <= 122 {
        b - 97 + 26
    } else if b >= 48 && b <= 57 {
        b - 48 + 52
    } else if b == 43 {
        62
    } else if b == 47 {
        63
    } else {
        0 - 1
    }
}

impl Codec for Base64 {
    fn encode(self, input: &str) -> String {
        let bytes = input.as_bytes();
        let len: usize = bytes.len();
        let mut result: String = String.new();
        let mut i: usize = 0;

        // Process complete 3-byte groups
        while i + 2 < len {
            let b0: i32 = bytes[i] as i32;
            let b1: i32 = bytes[i + 1] as i32;
            let b2: i32 = bytes[i + 2] as i32;

            result.push(b64_encode_sextet(b0 >> 2) as char);
            result.push(b64_encode_sextet(((b0 & 3) << 4) | (b1 >> 4)) as char);
            result.push(b64_encode_sextet(((b1 & 15) << 2) | (b2 >> 6)) as char);
            result.push(b64_encode_sextet(b2 & 63) as char);

            i = i + 3;
        }

        // Handle remaining 1 or 2 bytes with padding
        let remaining: usize = len - i;
        if remaining == 1 {
            let b0: i32 = bytes[i] as i32;
            result.push(b64_encode_sextet(b0 >> 2) as char);
            result.push(b64_encode_sextet((b0 & 3) << 4) as char);
            result.push(61 as char);
            result.push(61 as char);
        } else if remaining == 2 {
            let b0: i32 = bytes[i] as i32;
            let b1: i32 = bytes[i + 1] as i32;
            result.push(b64_encode_sextet(b0 >> 2) as char);
            result.push(b64_encode_sextet(((b0 & 3) << 4) | (b1 >> 4)) as char);
            result.push(b64_encode_sextet((b1 & 15) << 2) as char);
            result.push(61 as char);
        }

        result
    }

    fn decode(self, input: &str) -> String {
        let bytes = input.as_bytes();
        let len: usize = bytes.len();
        let mut result: String = String.new();
        let mut i: usize = 0;

        while i + 3 < len {
            let c0: i32 = b64_decode_char(bytes[i] as i32);
            let c1: i32 = b64_decode_char(bytes[i + 1] as i32);
            let c2_raw: u8 = bytes[i + 2];
            let c3_raw: u8 = bytes[i + 3];

            if c0 < 0 || c1 < 0 {
                i = i + 4;
                continue;
            }

            // First byte: all 6 bits of c0 + top 2 bits of c1
            let byte0: i32 = (c0 << 2) | (c1 >> 4);
            result.push(byte0 as u8 as char);

            // Second byte (if not padding)
            if c2_raw != 61 {
                let c2: i32 = b64_decode_char(c2_raw as i32);
                let byte1: i32 = ((c1 & 15) << 4) | (c2 >> 2);
                result.push(byte1 as u8 as char);

                // Third byte (if not padding)
                if c3_raw != 61 {
                    let c3: i32 = b64_decode_char(c3_raw as i32);
                    let byte2: i32 = ((c2 & 3) << 6) | c3;
                    result.push(byte2 as u8 as char);
                }
            }

            i = i + 4;
        }

        result
    }
}

// --- Hex codec (bonus: exercises trait with two impls) ---

struct Hex {}

fn hex_digit(val: i32) -> u8 {
    if val < 10 {
        (48 + val) as u8
    } else {
        (97 + val - 10) as u8
    }
}

fn hex_value(b: i32) -> i32 {
    if b >= 48 && b <= 57 {
        b - 48
    } else if b >= 97 && b <= 102 {
        b - 97 + 10
    } else if b >= 65 && b <= 70 {
        b - 65 + 10
    } else {
        0 - 1
    }
}

impl Codec for Hex {
    fn encode(self, input: &str) -> String {
        let bytes = input.as_bytes();
        let len: usize = bytes.len();
        let mut result: String = String.new();

        let mut i: usize = 0;
        while i < len {
            let b: i32 = bytes[i] as i32;
            result.push(hex_digit((b >> 4) & 15) as char);
            result.push(hex_digit(b & 15) as char);
            i = i + 1;
        }

        result
    }

    fn decode(self, input: &str) -> String {
        let bytes = input.as_bytes();
        let len: usize = bytes.len();
        let mut result: String = String.new();

        let mut i: usize = 0;
        while i + 1 < len {
            let hi: i32 = hex_value(bytes[i] as i32);
            let lo: i32 = hex_value(bytes[i + 1] as i32);
            if hi >= 0 && lo >= 0 {
                let byte_val: i32 = (hi << 4) | lo;
                result.push(byte_val as u8 as char);
            }
            i = i + 2;
        }

        result
    }
}

// --- Entry point ---

fn usage() {
    println_str("Usage: b64 <codec> <mode> <input>");
    println_str("  b64 base64 encode <text>");
    println_str("  b64 base64 decode <base64text>");
    println_str("  b64 hex encode <text>");
    println_str("  b64 hex decode <hextext>");
    println_str("  b64 <codec> encode -f <file>");
    println_str("  b64 <codec> decode -f <file>");
}

fn main() -> i32 {
    let argc: i32 = args_count();
    if argc < 4 {
        usage();
        return 1;
    }

    let codec_name: &str = args_get(1);
    let mode: &str = args_get(2);
    let third: &str = args_get(3);

    // Get input text (from arg or file)
    let mut input_str: String = String.new();
    if str_eq(third, "-f") {
        if argc < 5 {
            println_str("Error: -f requires a filename");
            return 1;
        }
        let filename: &str = args_get(4);
        if !file_exists(filename) {
            print_str("Error: file not found: ");
            println_str(filename);
            return 1;
        }
        input_str.push_str(file_read_to_string(filename));
    } else {
        // Join remaining args as input
        let mut ai: i32 = 3;
        while ai < argc {
            if ai > 3 {
                input_str.push(32 as char);
            }
            input_str.push_str(args_get(ai));
            ai = ai + 1;
        }
    }

    let input: &str = input_str.as_str();

    // Dispatch on codec and mode
    if str_eq(codec_name, "base64") {
        let codec: Base64 = Base64 {};
        if str_eq(mode, "encode") {
            let out: String = codec.encode(input);
            println(out.as_str());
        } else if str_eq(mode, "decode") {
            let out: String = codec.decode(input);
            print(out.as_str());
        } else {
            print_str("Error: unknown mode: ");
            println_str(mode);
            return 1;
        }
    } else if str_eq(codec_name, "hex") {
        let codec: Hex = Hex {};
        if str_eq(mode, "encode") {
            let out: String = codec.encode(input);
            println(out.as_str());
        } else if str_eq(mode, "decode") {
            let out: String = codec.decode(input);
            print(out.as_str());
        } else {
            print_str("Error: unknown mode: ");
            println_str(mode);
            return 1;
        }
    } else {
        print_str("Error: unknown codec: ");
        println_str(codec_name);
        println_str("  Available: base64, hex");
        return 1;
    }

    0
}
