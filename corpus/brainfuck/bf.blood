// Brainfuck Interpreter in Blood
//
// A complete Brainfuck interpreter demonstrating Blood as a systems
// programming language.
//
// Features exercised:
//   - File I/O (file_read_to_string, file_exists)
//   - Command-line arguments (args_count, args_get)
//   - Raw memory allocation (alloc, free, ptr_read_u8, ptr_write_u8)
//   - Byte-level string processing (as_bytes, indexing)
//   - Control flow (while, if/else, loops)
//   - Integer and byte arithmetic with casts
//
// Usage: blood run bf.blood -- <program.bf>

fn main() -> i32 {
    let argc: i32 = args_count();
    if argc < 2 {
        println_str("Usage: bf <program.bf>");
        return 1;
    }

    let filename: &str = args_get(1);
    if !file_exists(filename) {
        print_str("Error: file not found: ");
        println_str(filename);
        return 1;
    }

    let source: &str = file_read_to_string(filename);
    let program = source.as_bytes();
    let program_len: usize = program.len();

    // Validate bracket matching before execution
    let mut bracket_depth: i32 = 0;
    let mut ci: usize = 0;
    while ci < program_len {
        let c: u8 = program[ci];
        if c == 91 {
            bracket_depth = bracket_depth + 1;
        } else if c == 93 {
            bracket_depth = bracket_depth - 1;
        }
        if bracket_depth < 0 {
            println_str("Error: unmatched ']'");
            return 1;
        }
        ci = ci + 1;
    }
    if bracket_depth != 0 {
        println_str("Error: unmatched '['");
        return 1;
    }

    // Allocate tape (30000 cells, zero-initialized)
    let tape_size: u64 = 30000;
    let tape: u64 = alloc(tape_size);
    let mut zi: u64 = 0;
    while zi < tape_size {
        ptr_write_u8(tape + zi, 0);
        zi = zi + 1;
    }

    // Interpreter state
    let mut pc: usize = 0;
    let mut dp: u64 = 0;

    // Main interpreter loop
    while pc < program_len {
        let instr: u8 = program[pc];

        if instr == 62 {
            // >  move data pointer right
            dp = dp + 1;
        } else if instr == 60 {
            // <  move data pointer left
            if dp > 0 {
                dp = dp - 1;
            }
        } else if instr == 43 {
            // +  increment cell
            let val: i32 = ptr_read_u8(tape + dp) as i32;
            let next: i32 = (val + 1) % 256;
            ptr_write_u8(tape + dp, next as u8);
        } else if instr == 45 {
            // -  decrement cell
            let val: i32 = ptr_read_u8(tape + dp) as i32;
            let next: i32 = (val + 255) % 256;
            ptr_write_u8(tape + dp, next as u8);
        } else if instr == 46 {
            // .  output cell as character
            let val: u8 = ptr_read_u8(tape + dp);
            print_char(val as char);
        } else if instr == 44 {
            // ,  input character from stdin
            let line: String = read_line();
            let s: &str = line.as_str();
            let bytes = s.as_bytes();
            if bytes.len() > 0 {
                ptr_write_u8(tape + dp, bytes[0]);
            } else {
                ptr_write_u8(tape + dp, 0);
            }
        } else if instr == 91 {
            // [  jump forward past matching ] if cell is zero
            let val: u8 = ptr_read_u8(tape + dp);
            if val == 0 {
                let mut depth: i32 = 1;
                while depth > 0 {
                    pc = pc + 1;
                    let c: u8 = program[pc];
                    if c == 91 {
                        depth = depth + 1;
                    } else if c == 93 {
                        depth = depth - 1;
                    }
                }
            }
        } else if instr == 93 {
            // ]  jump backward to matching [ if cell is nonzero
            let val: u8 = ptr_read_u8(tape + dp);
            if val != 0 {
                let mut depth: i32 = 1;
                while depth > 0 {
                    pc = pc - 1;
                    let c: u8 = program[pc];
                    if c == 93 {
                        depth = depth + 1;
                    } else if c == 91 {
                        depth = depth - 1;
                    }
                }
            }
        }

        pc = pc + 1;
    }

    free(tape);
    0
}
