// Test: 3-field handler state
// EXPECT: a=3 b=2 c=1
effect T {
    op inc_a() -> ();
    op inc_b() -> ();
    op inc_c() -> ();
}

deep handler H for T {
    let mut a: i32
    let mut b: i32
    let mut c: i32
    return(x) {
        let msg: &str = format!("a={} b={} c={}", a, b, c);
        println_str(msg);
        x
    }
    op inc_a() { a = a + 1; resume(()) }
    op inc_b() { b = b + 1; resume(()) }
    op inc_c() { c = c + 1; resume(()) }
}

fn main() -> i32 {
    with H { a: 0, b: 0, c: 0 } handle {
        perform T.inc_a();
        perform T.inc_a();
        perform T.inc_a();
        perform T.inc_b();
        perform T.inc_b();
        perform T.inc_c();
    };
    0
}
