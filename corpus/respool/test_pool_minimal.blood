// Minimal respool: 3 state fields, checkout returning struct, checkin taking struct
// EXPECT: checkout: 0
// EXPECT: checkin: 0
// EXPECT: done: 1 0
struct Entry { slot: i32 }
effect Pool {
    op checkout() -> Entry;
    op checkin(e: Entry) -> ();
}
deep handler H for Pool {
    let mut out: i32
    let mut cap: i32
    let mut next: i32
    return(x) {
        let msg: &str = format!("done: {} {}", out, next);
        println_str(msg);
        x
    }
    op checkout() {
        let s: i32 = next;
        next = next + 1;
        out = out + 1;
        print_str("checkout: ");
        println_int(s);
        resume(Entry { slot: s })
    }
    op checkin(e) {
        out = out - 1;
        print_str("checkin: ");
        println_int(e.slot);
        resume(())
    }
}
fn main() -> i32 {
    with H { out: 0, cap: 4, next: 0 } handle {
        let e: Entry = perform Pool.checkout();
        perform Pool.checkin(e);
    };
    0
}
