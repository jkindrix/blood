// effectful — Proving Ground Program 1: Same logic, swappable runtime
//
// A data processing pipeline where the SAME function runs in different modes
// by installing different effect handlers. No flags, no if/else, no DI.
//
// Mode 1 (Real):  prints output, logs to stderr, strict validation (aborts on invalid)
// Mode 2 (Test):  captures output count, silent logging, lenient validation
//
// Exercises:
//   - Multiple handler definitions for the same effect (handler swapping)
//   - Effect composition (4 effects nested: Output, Log, Validate, Counter)
//   - Parametric effects (Counter<i32>)
//   - Non-resumptive handlers (StrictValidate aborts pipeline on first invalid)
//   - Handler state mutation (counting operations)

// ============================================================
// Data types
// ============================================================

struct Record {
    name: String,
    value: i32,
    valid: bool,
}

fn make_record(name: &str, value: i32, valid: bool) -> Record {
    let mut s: String = String.new();
    let bytes = name.as_bytes();
    let mut i: usize = 0;
    while i < bytes.len() {
        s.push(bytes[i] as char);
        i += 1;
    }
    Record { name: s, value: value, valid: valid }
}

fn make_test_data() -> Vec<Record> {
    let mut records: Vec<Record> = Vec.new();
    records.push(make_record("alpha", 10, true));
    records.push(make_record("beta", 20, true));
    records.push(make_record("gamma", 30, false));
    records.push(make_record("delta", 40, true));
    records
}

fn int_to_string(v: i32) -> String {
    let mut s: String = String.new();
    if v == 0 {
        s.push(48 as char);
        return s;
    }
    let mut tmp: Vec<u8> = Vec.new();
    let mut n: i32 = v;
    if n < 0 { n = 0 - n; }
    while n > 0 {
        tmp.push((48 + (n % 10)) as u8);
        n = n / 10;
    }
    if v < 0 { s.push(45 as char); }
    let mut k: usize = tmp.len();
    while k > 0 {
        k -= 1;
        s.push(tmp[k] as char);
    }
    s
}

// ============================================================
// Effects — WHAT the pipeline needs, not HOW
// ============================================================

effect Output {
    op write_line(msg: &str) -> ();
}

effect Log {
    op info(msg: &str) -> ();
    op warn(msg: &str) -> ();
}

effect Validate {
    op check(value: i32, valid: bool) -> bool;
    op reject(name: &str) -> i32;
}

effect Counter {
    op increment() -> ();
    op get_count() -> i32;
}

// ============================================================
// Pipeline — pure logic, zero I/O
// ============================================================

fn process_records(records: &Vec<Record>) -> i32 / {Output, Log, Validate, Counter} {
    let mut i: usize = 0;
    while i < records.len() {
        let r: &Record = &records[i];
        perform Log.info(r.name.as_str());

        let ok: bool = perform Validate.check(r.value, r.valid);
        if !ok {
            perform Validate.reject(r.name.as_str());
        } else {
            let mut line: String = String.new();
            let bytes = r.name.as_bytes();
            let mut j: usize = 0;
            while j < bytes.len() {
                line.push(bytes[j] as char);
                j += 1;
            }
            line.push(58 as char);
            line.push(32 as char);
            let val_str: String = int_to_string(r.value);
            let val_bytes = val_str.as_bytes();
            let mut vb: usize = 0;
            while vb < val_bytes.len() {
                line.push(val_bytes[vb] as char);
                vb += 1;
            }
            perform Output.write_line(line.as_str());
            perform Counter.increment();
        }
        i += 1;
    }
    perform Counter.get_count()
}

// ============================================================
// Real-Mode Handlers — prints to stdout, strict, counting
// ============================================================

deep handler RealOutput for Output {
    return(x) { x }
    op write_line(msg) {
        println_str(msg);
        resume(())
    }
}

deep handler StderrLog for Log {
    return(x) { x }
    op info(msg) {
        print_str("[info] ");
        println_str(msg);
        resume(())
    }
    op warn(msg) {
        print_str("[warn] ");
        println_str(msg);
        resume(())
    }
}

// Non-resumptive: rejects abort the pipeline immediately
deep handler StrictValidate for Validate {
    return(x) { x }
    op check(value, valid) {
        resume(valid)
    }
    op reject(name) {
        print_str("[ABORT] ");
        println_str(name);
        0 - 1
    }
}

deep handler RealCounter for Counter {
    let mut count: i32

    return(x) { x }
    op increment() {
        count += 1;
        resume(())
    }
    op get_count() {
        resume(count)
    }
}

// ============================================================
// Test-Mode Handlers — silent, lenient, counting
// ============================================================

deep handler TestOutput for Output {
    let mut count: i32

    return(x) { x }
    op write_line(msg) {
        count += 1;
        resume(())
    }
}

deep handler SilentLog for Log {
    return(x) { x }
    op info(msg) {
        resume(())
    }
    op warn(msg) {
        resume(())
    }
}

// Resumptive: lenient mode passes everything
deep handler LenientValidate for Validate {
    return(x) { x }
    op check(value, valid) {
        resume(true)
    }
    op reject(name) {
        resume(0)
    }
}

deep handler TestCounter for Counter {
    let mut count: i32

    return(x) { x }
    op increment() {
        count += 1;
        resume(())
    }
    op get_count() {
        resume(count)
    }
}

// ============================================================
// Main — run the SAME pipeline with different handlers
// ============================================================

fn main() -> i32 {
    let data: Vec<Record> = make_test_data();

    // Mode 1: Real — strict validation aborts at gamma (invalid)
    println_str("=== Real Mode ===");
    let real_count: i32 = with RealOutput {} handle {
        with StderrLog {} handle {
            with StrictValidate {} handle {
                with RealCounter { count: 0 } handle {
                    process_records(&data)
                }
            }
        }
    };
    print_str("real processed: ");
    println_int(real_count);

    println_str("");

    // Mode 2: Test — lenient, all 4 records pass (gamma treated as valid)
    println_str("=== Test Mode ===");
    let test_count: i32 = with TestOutput { count: 0 } handle {
        with SilentLog {} handle {
            with LenientValidate {} handle {
                with TestCounter { count: 0 } handle {
                    process_records(&data)
                }
            }
        }
    };
    print_str("test processed: ");
    println_int(test_count);

    println_str("done");
    0
}
